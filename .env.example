# Copy to `.env` and fill in your values. Never commit your real .env.
# Obtain a free API key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Optional logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional pipeline overrides (CLI flags take precedence over these).
# FRED_SERIES_ID=DEXUSEU
# FRED_TRAIN_SIZE=0.80
# FRED_WINDOW_SIZE=20
# FRED_HIDDEN_SIZE=128
# FRED_NUM_LAYERS=2
# FRED_LEARNING_RATE=0.001
# FRED_EPOCHS=100
# FRED_SEED=42
